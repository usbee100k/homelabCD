#############################################
# Cluster Configuration
#############################################

# The cluster name is set in config/cluster.yaml (cluster.name).

VIP_ADDRESS="192.168.50.222"

POD_SUBNET="10.10.0.0/16"

SERVICE_SUBNET="10.96.0.0/12"

DNS_DOMAIN="cluster.local"


#############################################
# GIT CONFIGURATION
#############################################

GIT_USER_NAME="homelab-bootstrap"

GIT_USER_EMAIL="homelab-bootstrap@localhost"

GIT_BRANCH="main"


#############################################
# Features
#############################################

INSTALL_CILIUM=true

INSTALL_LONGHORN=true

INSTALL_INGRESS=true

INSTALL_ARGOCD=true

INSTALL_METRICS_SERVER=true

INSTALL_CERT_MANAGER=true


#############################################
# Cilium
#############################################

CILIUM_VERSION="1.18.1"


#############################################
# GITHUB
#############################################

# The user selects these during GitOps bootstrap.
# Do NOT hard-code a personal GitHub repository here.

GITHUB_REPO=""

# Optional KubesTUI source repository.

KUBESTUI_REPO="https://github.com/usbee100k/KubesTUI.git"

# Optional local checkout if GitHub is unavailable.
# KUBESTUI_SRC="/root/KubesTUI"